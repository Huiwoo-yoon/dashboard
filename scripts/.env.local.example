# scripts/.env.local 로 복사해서 채우기 (이 파일은 git에 올라가지 않음)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase → Project Settings → API → service_role (RLS 우회 키! 이 맥미니에만 보관)
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# 비워두면 dash_ 데이터의 주인을 자동으로 찾음
# DASH_USER_EMAIL=
# 식단 인사이트에 반영할 내 상황 (선택, Gemini로 전송됨)
# MEAL_CONTEXT=혈당 관리 중이라 식후 혈당 스파이크에 신경 씀
